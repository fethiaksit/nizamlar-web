# ==============================================================================
# NİZAMLAR BASKI — TÜRKTiCARET CPANEL ÇEVRE DEĞİŞKENLERİ (.env.example)
# ==============================================================================
# Bu dosyayı .env adıyla kaydedip veritabanı şifrenizi giriniz.
# En güvenli kullanım: .env dosyasını public_html dışında (/home/kullanici/.env)
# konumlandırmaktır. Sistem hem üst klasördeki hem de kökteki .env'yi tanır.
# ==============================================================================

# Veritabanı Yapılandırması (MySQL / MariaDB)
DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cpaneluser_nizamlar_db
DB_USER=cpaneluser_nizamlar_user
DB_PASS=Veritabani_Guclu_Sifreniz_Buraya
DB_CHARSET=utf8mb4

# Uygulama Güvenlik Anahtarı (İsteğe bağlı 64 karakterli hex)
# Boş bırakırsanız sistem storage/app_secret.key içinde otomatik benzersiz anahtar üretir.
APP_SECRET=

# Teklif ve İletişim Bildirim E-postası
CONTACT_NOTIFICATION_EMAIL=nizamlartekstill@gmail.com
