# Kopyalayın: cp .env.example .env  — ve her değeri kendi güçlü değerinizle değiştirin.
# Rastgele değer üretmek için: openssl rand -hex 32
# ASLA gerçek değerleri depoya commit etmeyin.

# --- Express ---
PORT=3030
NODE_ENV=development
PUBLIC_SITE_URL=http://localhost:3030
DIRECTUS_URL=http://127.0.0.1:8055
# Teklif formu için kısıtlı servis kullanıcısının statik token'ı (node cms/setup_service_user.js üretir)
DIRECTUS_SERVICE_TOKEN=

# --- PostgreSQL ---
POSTGRES_USER=directus
POSTGRES_DB=nizamlar_cms_db
POSTGRES_PASSWORD=change-me-postgres-password

# --- Directus ---
DIRECTUS_KEY=change-me-uuid-or-random-hex
DIRECTUS_SECRET=change-me-random-hex-64
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-strong-admin-password
